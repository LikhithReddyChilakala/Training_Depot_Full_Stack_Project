<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="depot-header" data-grid-id="header">
  <div class="page-shell depot-header__bar">
    <a href="${ctx}/" class="depot-header__brand">
      <svg class="depot-header__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="1"/>
        <path d="M3 9h18M9 3v18"/>
      </svg>
      TRAINING DEPOT
    </a>

    <c:choose>
      <c:when test="${not empty sessionScope.loggedInUser && sessionScope.loggedInUser.role == 'ADMIN'}">
        <%-- ADMIN: staff-oriented nav only. No search, no Equipment browsing
             link, and deliberately no KIT - the admin console never leads
             an administrator toward the customer checkout. --%>
        <nav class="depot-header__nav">
          <a href="${ctx}/admin">CONTROL TERMINAL</a>
          <a href="${ctx}/admin/products">EQUIPMENT RECORDS</a>
          <a href="${ctx}/admin/orders">ORDER LEDGER</a>
        </nav>

        <div class="depot-header__actions">
          <a href="${ctx}/logout" class="btn btn--ghost btn--small">LOG OUT</a>
        </div>
      </c:when>
      <c:otherwise>
        <form class="depot-header__search" method="get" action="${ctx}/equipment">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" name="q" placeholder="LOOK FOR EQUIPMENT" value="${fn:escapeXml(query)}" />
        </form>

        <nav class="depot-header__nav">
          <a href="${ctx}/equipment">Equipment</a>
        </nav>

        <div class="depot-header__actions">
          <a href="${ctx}/kit" class="kit-link">
            KIT
            <c:if test="${kitCount > 0}"><span class="kit-link__badge">${kitCount}</span></c:if>
          </a>
          <c:choose>
            <c:when test="${not empty sessionScope.loggedInUser}">
              <a href="${ctx}/orders" class="btn btn--ghost btn--small">${fn:escapeXml(sessionScope.loggedInUser.username)}</a>
              <a href="${ctx}/logout" class="btn btn--ghost btn--small">LOG OUT</a>
            </c:when>
            <c:otherwise>
              <a href="${ctx}/login" class="btn btn--primary btn--small">DEPOT ACCESS</a>
            </c:otherwise>
          </c:choose>
        </div>
      </c:otherwise>
    </c:choose>
  </div>
</header>
